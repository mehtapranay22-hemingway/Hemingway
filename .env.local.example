# Required — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required — Volcano Engine Ark console (ark.console.volcengine.com). Leave
# unset to run the whole Seedance pipeline in mock mode (no spend, fake but
# realistic async job lifecycle) — see lib/seedance.ts for what's confirmed
# vs. still needs verifying against your real Ark account before going live.
VOLC_API_KEY=
VOLC_MODEL_ENDPOINT=doubao-seedance-2-5
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Only used for avatar photo listing now (character reference source) — get
# from app.heygen.com/settings/api. Not used for rendering anymore.
HEYGEN_API_KEY=

# Legacy — Shotstack was only ever part of the old (now replaced) B-roll
# compose pipeline. Kling has been removed entirely. Not required for the
# active Seedance pipeline.
SHOTSTACK_API_KEY=

# Paddle — subscription billing (lib/billing.ts, lib/paddle.ts). Leave
# PADDLE_API_KEY unset to run billing in dev-simulated mode (no real Paddle
# involved, /billing's "Subscribe" button just activates the plan directly)
# — this is only allowed outside production. Use SANDBOX (PADDLE_ENV=sandbox,
# api.sandbox base URL, works immediately without business approval) until
# this has been verified end to end; never go live without explicit approval.
# Paddle is a Merchant of Record and bills in USD regardless of seller
# country — unlike Paystack, whose South African accounts settle in ZAR only.
PADDLE_API_KEY=
PADDLE_ENV=sandbox
PADDLE_WEBHOOK_SECRET=

# One recurring Price per self-serve tier — create a Product with 3 Prices
# in the Paddle dashboard (sandbox first) then paste each Price id (pri_...)
# here. Checkout always charges exactly whatever each Price is configured
# for — never a manually-entered amount. The $49/$139/$189 figures in
# lib/pricing.ts are display copy only.
PADDLE_PRICE_MINIMUM=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_SCALE=

# Client-side token (Developer Tools → Authentication → Client-side tokens —
# a different credential from PADDLE_API_KEY above, and safe to ship to the
# browser like a Stripe publishable key). Used by app/billing/page.tsx to
# open Paddle.js's checkout overlay.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Client-side mirrors of the PADDLE_PRICE_* ids above — not secret, just
# catalog identifiers, used only to fetch a localized/formatted price
# preview (Paddle.PricePreview) for display. Keep these in sync with the
# server-only ones above.
NEXT_PUBLIC_PADDLE_PRICE_MINIMUM=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH=
NEXT_PUBLIC_PADDLE_PRICE_SCALE=

# Absolute base URL used for Paddle's post-checkout redirect and for links
# in verification/reset emails — defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — transactional email (lib/email.ts). Get a key from
# resend.com/api-keys. Leave unset to skip sending entirely (logs a warning)
# so signup/reset flows still work locally without real email.
RESEND_API_KEY=
# Until a sending domain is verified in Resend, mail can only go out from
# their shared onboarding@resend.dev address — fine for testing, but set
# this to something on your verified domain before relying on deliverability.
RESEND_FROM_EMAIL=Hemingway <onboarding@resend.dev>
