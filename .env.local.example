# Required — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required — Volcano Engine Ark console (ark.console.volcengine.com). Leave
# unset to run the whole Seedance pipeline in mock mode (no spend, fake but
# realistic async job lifecycle) — see lib/seedance.ts for what's confirmed
# vs. still needs verifying against your real Ark account before going live.
VOLC_API_KEY=
VOLC_MODEL_ENDPOINT=doubao-seedance-2-5
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Only used for avatar photo listing now (character reference source) — get
# from app.heygen.com/settings/api. Not used for rendering anymore.
HEYGEN_API_KEY=

# Legacy — Shotstack was only ever part of the old (now replaced) B-roll
# compose pipeline. Kling has been removed entirely. Not required for the
# active Seedance pipeline.
SHOTSTACK_API_KEY=

# Lemon Squeezy — subscription billing (lib/billing.ts, lib/lemonsqueezy.ts).
# Leave LEMONSQUEEZY_API_KEY/STORE_ID unset to run billing in dev-simulated
# mode (no real Lemon Squeezy involved, /billing's "Subscribe" button just
# activates the plan directly) — this is only allowed outside production.
# Use TEST MODE (Lemon Squeezy has a store-level "Test mode" toggle) until
# this has been verified end to end; never go live without explicit approval.
# Lemon Squeezy is a Merchant of Record, so — unlike Stripe/Paystack — it
# isn't gated by which country the account holder is in.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# One recurring Variant per self-serve tier — create a Product with 3
# pricing Variants in the Lemon Squeezy dashboard (test mode) first, then
# paste each Variant's numeric id here. Checkout always charges exactly
# whatever each Variant is priced at — never a manually-entered amount. The
# $49/$139/$189 figures in lib/pricing.ts are display copy only.
LEMONSQUEEZY_VARIANT_MINIMUM=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_SCALE=

# Absolute base URL used for Lemon Squeezy's post-checkout redirect —
# defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
